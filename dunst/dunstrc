[global]
    monitor = 0
    follow = mouse

    width = 300
    height = 300
    origin = top-right
    offset = 15x50

    frame_width = 2
    frame_color = "#525f96"
    separator_color = frame
    corner_radius = 6
    gap_size = 6

    padding = 12
    horizontal_padding = 12

    font = JetBrains Mono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false

    sort = yes
    idle_threshold = 120
    ignore_newline = no
    title = Dunst
    class = Dunst

    transparency = 10
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0b0e14"
    foreground = "#62735a"
    frame_color = "#333a52"
    timeout = 5

[urgency_normal]
    background = "#0b0e14"
    foreground = "#b8bcd6"
    frame_color = "#525f96"
    timeout = 8

[urgency_critical]
    background = "#0b0e14"
    foreground = "#d7d9ee"
    frame_color = "#c4694a"
    timeout = 0
