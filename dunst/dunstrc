[global]
    monitor = 0
    follow = mouse

    width = 300
    height = 300
    origin = top-right
    offset = 15x50

    frame_width = 2
    frame_color = "#c99a5b"
    separator_color = frame
    corner_radius = 6
    gap_size = 6

    padding = 12
    horizontal_padding = 12

    font = JetBrains Mono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false

    sort = yes
    idle_threshold = 120
    ignore_newline = no
    title = Dunst
    class = Dunst

    transparency = 10
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#16110b"
    foreground = "#6b5a42"
    frame_color = "#3a2f20"
    timeout = 3

[urgency_normal]
    background = "#16110b"
    foreground = "#e4d3b0"
    frame_color = "#c99a5b"
    timeout = 4

[urgency_critical]
    background = "#16110b"
    foreground = "#f5ead2"
    frame_color = "#b3542e"
    timeout = 0
